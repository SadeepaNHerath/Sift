<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: deep Library scanning requires unrestricted FS access + FDA.
	     Mac App Store is not a supported distribution path for this product. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
